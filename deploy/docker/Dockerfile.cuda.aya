# VoxEdge GPU image for the SMALL model (tiny-aya), used to validate the CUDA
# path cheaply before committing to Gemma. Same build as Dockerfile.cuda, but
# downloads tiny-aya and runs the `aya-cuda` profile.
#
# Multi-stage: the builder compiles llama-cpp-python against CUDA (multi-minute,
# large intermediate layer); the runtime image copies only the installed wheel.

# Ubuntu 22.04 (jammy), NOT 24.04 (noble): noble's apt repos ship python3.12 and
# have no python3.11 package, so the 24.04 images fail `apt-get install python3.11`.
ARG CUDA_IMAGE=nvcr.io/nvidia/cuda:12.6.3-devel-ubuntu22.04
# cudnn-runtime variant bundles cuDNN 9, which onnxruntime-gpu requires at
# runtime. Without it, CUDAExecutionProvider silently falls back to CPU and
# /info will mis-report the embedder and reranker as "cuda" when they're
# actually running on CPU. See docs/gpu-profile-lessons.md for the story.
ARG CUDA_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

FROM ${CUDA_IMAGE} AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3.11 python3.11-venv python3-pip build-essential cmake git curl && \
    rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv
RUN python3.11 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN pip install --upgrade pip wheel

# Rebuild llama-cpp-python with CUDA kernels compiled in. Pinned version
# matches the range in pyproject.toml.
# Pin CUDA target architectures to the GPUs Fly actually offers. Without this,
# llama.cpp compiles kernels for EVERY arch (sm_50..sm_90) — ~5-6x slower
# (~20 min vs ~3-4 min). Compute capabilities of Fly's GPU lineup:
#   80 = A100 (a100-40gb / a100-80gb)   86 = A10 (a10)   89 = L40S (l40s)
ENV CMAKE_ARGS="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=80;86;89"
ENV FORCE_CMAKE=1
RUN pip install --no-cache-dir "llama-cpp-python>=0.3.23"

WORKDIR /app
COPY pyproject.toml .
COPY src/ src/
RUN pip install --no-cache-dir "."

# Install onnxruntime-gpu AFTER the voxedge package. FastEmbed pulls in
# plain `onnxruntime` (CPU) as a transitive dep; if both are installed
# Python imports the CPU one and CUDA never activates. Remove it first,
# then force-reinstall the GPU package so its shared files are intact.
RUN pip uninstall -y onnxruntime || true && \
    pip install --no-cache-dir --force-reinstall --no-deps onnxruntime-gpu


FROM ${CUDA_RUNTIME_IMAGE}

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3.11 curl unzip libreoffice-core libreoffice-writer libreoffice-calc libreoffice-impress && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.14"
ENV PATH="/root/.bun/bin:/opt/venv/bin:$PATH"

RUN bun install -g @llamaindex/liteparse@2.0.4

ENV VIRTUAL_ENV=/opt/venv
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY pyproject.toml .
COPY src/ src/

ENV EDGE_MODEL_PROFILE=aya-cuda
ENV EDGE_MODEL_PATH=/data/models/tiny-aya-global-q4_k_m.gguf
ENV EDGE_N_CTX=4096
# GPU inference is fast enough that the Pi's 100-token default is artificially
# short. Give the small model some room.
ENV EDGE_MAX_TOKENS=400
# Norwegian corpus -> multilingual reranker (VRAM is plentiful on a GPU box).
ENV EDGE_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

RUN mkdir -p /data/models && \
    curl -L -o /data/models/tiny-aya-global-q4_k_m.gguf \
    "https://huggingface.co/CohereLabs/tiny-aya-global-GGUF/resolve/main/tiny-aya-global-q4_k_m.gguf"

COPY data/corpus/ /data/corpus/
RUN mkdir -p /data/qdrant

EXPOSE 8080
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8080"]
